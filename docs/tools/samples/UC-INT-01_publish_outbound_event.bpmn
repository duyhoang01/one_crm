<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  id="Definitions_UC_INT_01" targetNamespace="http://onecrm/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="UC-INT-01 — Gửi sự kiện đi (Publish Outbound Event)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System (CRM — Outbox &amp; Worker)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF01a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF02b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF03b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Product" name="Sản phẩm (Product Module — hệ thống ngoài)">
        <bpmn:flowNodeRef>Node6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF03a</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Thao tác thương mại được chốt" />
    <bpmn:exclusiveGateway id="Gw1" name="① Sản phẩm hỗ trợ loại sự kiện này?" />
    <bpmn:serviceTask id="Node2" name="② Ghi sự kiện vào Outbox 'Chờ gửi' + metadata — TRONG CÙNG giao dịch nghiệp vụ" />
    <bpmn:serviceTask id="Node3" name="③ Kết thúc giao dịch — trả phản hồi người dùng NGAY, không chờ sản phẩm" />
    <bpmn:serviceTask id="Node4" name="④ Worker nền lấy sự kiện 'Chờ gửi', giữ thứ tự theo từng sub, đẩy lên hàng đợi" />
    <bpmn:exclusiveGateway id="Gw5" name="⑤ Đẩy lên hàng đợi thành công?" />
    <bpmn:serviceTask id="EF01a" name="EF-01a. Không sinh sự kiện, không đẩy (nút đã ẩn ở UC-LIC-03)" />
    <bpmn:serviceTask id="EF02a" name="EF-02a. Huỷ TOÀN BỘ giao dịch — nghiệp vụ cũng không được ghi; báo lỗi, yêu cầu làm lại" />
    <bpmn:serviceTask id="AF01a" name="AF-01a. 'Đang thử lại', tăng số lần thử, chờ giãn cách tăng dần" />
    <bpmn:exclusiveGateway id="AF01b" name="AF-01b. Đẩy lại thành công?" />
    <bpmn:serviceTask id="AF02a" name="AF-02a. 'Đã ngừng tự gửi lại', ghi lý do lỗi lần cuối, DỪNG" />
    <bpmn:serviceTask id="AF02b" name="AF-02b. Cảnh báo vận hành; hiện ở UC-INT-04 để gửi lại tay" />
    <bpmn:serviceTask id="AF03b" name="AF-03b. Đối chiếu correlation_id → 'Sản phẩm từ chối', hiện lý do ở UC-INT-04, đưa vào UC-LIC-04" />
    <bpmn:receiveTask id="Node6" name="⑥ (async) Nhận sự kiện, chống trùng theo event_id, xử lý → phản hồi inbound (UC-INT-02)" />
    <bpmn:sendTask id="AF03a" name="AF-03a. Lỗi vĩnh viễn / hết trần thử → gửi subscription.command_failed + correlation_id + lý do" />

    <bpmn:endEvent id="End1" name="End 1 · Đã tới hàng đợi" />
    <bpmn:endEvent id="End2" name="End 2 · Đã ngừng tự gửi lại → UC-INT-04" />
    <bpmn:endEvent id="End3" name="End 3 · Sản phẩm từ chối lệnh" />
    <bpmn:endEvent id="End4" name="End 4 · Sản phẩm không hỗ trợ" />
    <bpmn:endEvent id="End5" name="End 5 · Huỷ giao dịch, nghiệp vụ không ghi" />

    <bpmn:textAnnotation id="TRIGGER">
      <bpmn:text>TRIGGER — Một thao tác thương mại vừa chốt ở Subscription (xác nhận / tạm dừng / khôi phục / thu hồi / gia hạn), HOẶC yêu cầu cập nhật mức dùng → sinh 1 sự kiện cần gửi sang sản phẩm.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As1" sourceRef="TRIGGER" targetRef="StartEvent_1" />

    <bpmn:sequenceFlow id="M1" sourceRef="StartEvent_1" targetRef="Gw1" />
    <bpmn:sequenceFlow id="M2" name="Có" sourceRef="Gw1" targetRef="Node2" />
    <bpmn:sequenceFlow id="M3" sourceRef="Node2" targetRef="Node3" />
    <bpmn:sequenceFlow id="M4" sourceRef="Node3" targetRef="Node4" />
    <bpmn:sequenceFlow id="M5" sourceRef="Node4" targetRef="Gw5" />
    <bpmn:sequenceFlow id="M6" name="Có" sourceRef="Gw5" targetRef="End1" />

    <bpmn:sequenceFlow id="E1" name="Không" sourceRef="Gw1" targetRef="EF01a" />
    <bpmn:sequenceFlow id="E2" sourceRef="EF01a" targetRef="End4" />
    <bpmn:sequenceFlow id="E3" name="Không" sourceRef="Node2" targetRef="EF02a" />
    <bpmn:sequenceFlow id="E4" sourceRef="EF02a" targetRef="End5" />

    <bpmn:sequenceFlow id="AF1" name="Không" sourceRef="Gw5" targetRef="AF01a" />
    <bpmn:sequenceFlow id="AF2" sourceRef="AF01a" targetRef="AF01b" />
    <bpmn:sequenceFlow id="AF3" name="Có, đẩy được" sourceRef="AF01b" targetRef="End1" />
    <bpmn:sequenceFlow id="AF4" name="Chưa (còn dưới 10 lần)" sourceRef="AF01b" targetRef="AF01a" />
    <bpmn:sequenceFlow id="AF5" name="Không (đã đủ 10 lần)" sourceRef="AF01b" targetRef="AF02a" />
    <bpmn:sequenceFlow id="AF6" sourceRef="AF02a" targetRef="AF02b" />
    <bpmn:sequenceFlow id="AF7" sourceRef="AF02b" targetRef="End2" />

    <bpmn:sequenceFlow id="ASY" name="qua hàng đợi (async)" sourceRef="Node4" targetRef="Node6" />
    <bpmn:sequenceFlow id="AF8" name="lỗi / từ chối" sourceRef="Node6" targetRef="AF03a" />
    <bpmn:sequenceFlow id="AF9" sourceRef="AF03a" targetRef="AF03b" />
    <bpmn:sequenceFlow id="AF10" sourceRef="AF03b" targetRef="End3" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
