<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  id="Definitions_UC_INT_02" targetNamespace="http://onecrm/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="UC-INT-02 — Tiếp nhận &amp; xử lý sự kiện từ sản phẩm (Inbound)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System (CRM — Webhook Inbox &amp; Worker)">
        <bpmn:flowNodeRef>Gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF01a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF03a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF04a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF05a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF02b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Product" name="Sản phẩm (Product Module — hệ thống ngoài)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Trạng thái đổi / tới lịch báo / lệnh không thực thi được" />
    <bpmn:sendTask id="Node1" name="① Gửi sự kiện về CRM (kèm metadata: event_id, event_key, occurred_at, subscription_id, correlation_id, schema_version)" />

    <bpmn:exclusiveGateway id="Gw2" name="② Chữ ký hợp lệ?" />
    <bpmn:serviceTask id="Node3" name="③ Ghi nhận 'Đã nhận' + trả 200 OK cho sản phẩm NGAY (xử lý sau)" />
    <bpmn:exclusiveGateway id="Gw4" name="④ Đã xử lý event_id này chưa?" />
    <bpmn:exclusiveGateway id="Gw5" name="⑤ Map được về subscription?" />
    <bpmn:exclusiveGateway id="Gw6" name="⑥ Loại sự kiện có trong bảng ánh xạ?" />
    <bpmn:exclusiveGateway id="Gw7" name="⑦ occurred_at mới hơn tin đã áp dụng gần nhất?" />
    <bpmn:exclusiveGateway id="Gw8" name="⑧ Đủ trường bắt buộc?" />
    <bpmn:exclusiveGateway id="Gw9" name="⑨ Phân loại theo event_key?" />
    <bpmn:serviceTask id="Node9" name="⑨ Áp dụng theo bảng ánh xạ: cập nhật license_mirror.status (+ sub.end_date/status nếu license.activated)" />
    <bpmn:serviceTask id="Node10" name="⑩ Ghi 1 dòng tiến độ + nhật ký hoạt động → tin 'Đã xử lý'" />

    <bpmn:serviceTask id="EF01a" name="EF-01. Trả 4xx, từ chối NGAY — KHÔNG ghi WEBHOOK_INBOX; chỉ log hạ tầng (rate-limited + source IP)" />
    <bpmn:serviceTask id="EF02a" name="EF-02. Ghi nhận, nhãn 'không xác định được subscription', cảnh báo — không đoán" />
    <bpmn:serviceTask id="EF03a" name="EF-03. Ghi nhận, nhãn 'loại sự kiện lạ — không áp dụng', cảnh báo" />
    <bpmn:serviceTask id="EF04a" name="EF-04. Ghi nhận, nhãn 'đến muộn — không áp dụng' (không phải lỗi, đang bảo vệ dữ liệu)" />
    <bpmn:serviceTask id="EF05a" name="EF-05. Thử lại tối đa 5 lần → 'Xử lý lỗi', GIỮ NGUYÊN tin (thường lỗi phía CRM)" />

    <bpmn:serviceTask id="AF01a" name="AF-01a. Cập nhật số đã dùng + last_synced_at — KHÔNG ghi dòng tiến độ" />
    <bpmn:serviceTask id="AF01b" name="AF-01b. Nếu dùng > số đã bán: vẫn lưu, ghi 'bất thường dữ liệu' + cảnh báo" />
    <bpmn:serviceTask id="AF02a" name="AF-02a. Đối chiếu correlation_id → tìm đúng lệnh gốc đã gửi" />
    <bpmn:serviceTask id="AF02b" name="AF-02b. Đánh dấu lệnh gốc 'Sản phẩm từ chối' + lý do → UC-LIC-04 (KHÔNG đổi license)" />

    <bpmn:endEvent id="End1" name="End 1 · Đã áp dụng" />
    <bpmn:endEvent id="End2" name="End 2 · Tin trùng — bỏ qua" />
    <bpmn:endEvent id="End3" name="End 3 · Đã ghi nhận sản phẩm từ chối lệnh" />
    <bpmn:endEvent id="End4" name="End 4 · Ghi nhận, chưa áp dụng → chờ xử lý lại (UC-INT-05)" />
    <bpmn:endEvent id="End5" name="End 5 · Từ chối 4xx — không lưu inbox" />

    <bpmn:textAnnotation id="TRIGGER">
      <bpmn:text>TRIGGER — Sản phẩm gửi sự kiện khi trạng thái license đổi, khi báo mức dùng (chu kỳ 3 giờ), hoặc khi không thực thi được lệnh. Đây là ĐƯỜNG DUY NHẤT để trạng thái license trong CRM thay đổi (YT-1).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As1" sourceRef="TRIGGER" targetRef="StartEvent_1" />

    <bpmn:sequenceFlow id="M1" sourceRef="StartEvent_1" targetRef="Node1" />
    <bpmn:sequenceFlow id="M2" name="gửi tới CRM" sourceRef="Node1" targetRef="Gw2" />
    <bpmn:sequenceFlow id="M3" name="Có" sourceRef="Gw2" targetRef="Node3" />
    <bpmn:sequenceFlow id="M4" name="(chuyển xử lý nền)" sourceRef="Node3" targetRef="Gw4" />
    <bpmn:sequenceFlow id="M5" name="Chưa" sourceRef="Gw4" targetRef="Gw5" />
    <bpmn:sequenceFlow id="M6" name="Có" sourceRef="Gw5" targetRef="Gw6" />
    <bpmn:sequenceFlow id="M7" name="Có" sourceRef="Gw6" targetRef="Gw7" />
    <bpmn:sequenceFlow id="M8" name="Có" sourceRef="Gw7" targetRef="Gw8" />
    <bpmn:sequenceFlow id="M9" name="Có" sourceRef="Gw8" targetRef="Gw9" />
    <bpmn:sequenceFlow id="M10" name="license.* (đổi trạng thái)" sourceRef="Gw9" targetRef="Node9" />
    <bpmn:sequenceFlow id="M11" sourceRef="Node9" targetRef="Node10" />
    <bpmn:sequenceFlow id="M12" sourceRef="Node10" targetRef="End1" />

    <bpmn:sequenceFlow id="D1" name="Rồi → bỏ qua" sourceRef="Gw4" targetRef="End2" />

    <bpmn:sequenceFlow id="E1" name="Không" sourceRef="Gw2" targetRef="EF01a" />
    <bpmn:sequenceFlow id="E1b" sourceRef="EF01a" targetRef="End5" />
    <bpmn:sequenceFlow id="E2" name="Không" sourceRef="Gw5" targetRef="EF02a" />
    <bpmn:sequenceFlow id="E2b" sourceRef="EF02a" targetRef="End4" />
    <bpmn:sequenceFlow id="E3" name="Không" sourceRef="Gw6" targetRef="EF03a" />
    <bpmn:sequenceFlow id="E3b" sourceRef="EF03a" targetRef="End4" />
    <bpmn:sequenceFlow id="E4" name="Không" sourceRef="Gw7" targetRef="EF04a" />
    <bpmn:sequenceFlow id="E4b" sourceRef="EF04a" targetRef="End4" />
    <bpmn:sequenceFlow id="E5" name="Không" sourceRef="Gw8" targetRef="EF05a" />
    <bpmn:sequenceFlow id="E5b" sourceRef="EF05a" targetRef="End4" />

    <bpmn:sequenceFlow id="A1" name="usage_synced" sourceRef="Gw9" targetRef="AF01a" />
    <bpmn:sequenceFlow id="A2" sourceRef="AF01a" targetRef="AF01b" />
    <bpmn:sequenceFlow id="A3" sourceRef="AF01b" targetRef="End1" />
    <bpmn:sequenceFlow id="B1" name="command_failed" sourceRef="Gw9" targetRef="AF02a" />
    <bpmn:sequenceFlow id="B2" sourceRef="AF02a" targetRef="AF02b" />
    <bpmn:sequenceFlow id="B3" sourceRef="AF02b" targetRef="End3" />
  </bpmn:process>

