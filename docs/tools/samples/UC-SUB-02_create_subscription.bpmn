<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  id="Definitions_UC_SUB_02" targetNamespace="http://onecrm/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="UC-SUB-02 — Tạo Subscription" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Sales / Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF03a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF02a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AFCa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Hệ thống (CRM)">
        <bpmn:flowNodeRef>Step1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF01c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF03b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AF02b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AFCb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Vào form (Click + Thêm — UC-SUB-01)" />
    <bpmn:serviceTask id="Step1" name="1. Mở modal; sinh mã SUB-{YYYY}-{NNN}" />
    <bpmn:userTask id="Step2" name="2. Tìm &amp; chọn hợp đồng" />
    <bpmn:serviceTask id="Step3" name="3. Auto-fill KH/loại HĐ; xác định Gói &amp; Thời hạn; tính ngày; hint pool; scope" />
    <bpmn:userTask id="Step4" name="4. Nhập bắt buộc theo loại HĐ (seats / thụ hưởng + license); chọn scope" />
    <bpmn:userTask id="Step5" name="5. (Tùy chọn) chỉnh Ngày bắt đầu; Deal Code; Ghi chú" />
    <bpmn:userTask id="Step6" name="6. Click 💾 Tạo" />
    <bpmn:exclusiveGateway id="Gw7" name="7. Form hợp lệ?" />
    <bpmn:serviceTask id="Step8" name="8. Tạo sub DRAFT; đóng modal; toast; điều hướng UC-SUB-03" />
    <bpmn:endEvent id="End1" name="End 1 · Tạo thành công" />

    <bpmn:userTask id="AF01b" name="AF-01b. Chọn Gói sản phẩm" />
    <bpmn:serviceTask id="AF01a" name="AF-01a. Dropdown Gói (mỗi pool 1 option)" />
    <bpmn:serviceTask id="AF01c" name="AF-01c. Điền Thời hạn; cập nhật Ngày hết hạn; hint pool" />
    <bpmn:userTask id="AF03a" name="AF-03a. Xóa &amp; chọn hợp đồng khác" />
    <bpmn:serviceTask id="AF03b" name="AF-03b. Reset Sản phẩm/License/Ngày; chạy lại bước 3" />
    <bpmn:userTask id="AF02a" name="AF-02a. Chọn/nhập Ngày bắt đầu" />
    <bpmn:serviceTask id="AF02b" name="AF-02b. Tính lại Ngày hết hạn = start + duration − 1" />
    <bpmn:userTask id="AFCa" name="AF-Ca. Nhấn Hủy / ✕" />
    <bpmn:serviceTask id="AFCb" name="AF-Cb. Đóng modal; reset form" />
    <bpmn:endEvent id="End2" name="End 2 · Đã hủy" />
    <bpmn:serviceTask id="EF" name="EF. Lỗi inline (EF-01..05); giữ modal" />

    <bpmn:sequenceFlow id="S1" sourceRef="StartEvent_1" targetRef="Step1" />
    <bpmn:sequenceFlow id="S2" sourceRef="Step1" targetRef="Step2" />
    <bpmn:sequenceFlow id="S3" sourceRef="Step2" targetRef="Step3" />
    <bpmn:sequenceFlow id="S4" sourceRef="Step3" targetRef="Step4" />
    <bpmn:sequenceFlow id="S5" sourceRef="Step4" targetRef="Step5" />
    <bpmn:sequenceFlow id="S6" sourceRef="Step5" targetRef="Step6" />
    <bpmn:sequenceFlow id="S7" sourceRef="Step6" targetRef="Gw7" />
    <bpmn:sequenceFlow id="S8" name="Có" sourceRef="Gw7" targetRef="Step8" />
    <bpmn:sequenceFlow id="S9" sourceRef="Step8" targetRef="End1" />

    <bpmn:sequenceFlow id="A01t" name="RESELLER ≥ 2 pool" sourceRef="Step3" targetRef="AF01a" />
    <bpmn:sequenceFlow id="A01ab" sourceRef="AF01a" targetRef="AF01b" />
    <bpmn:sequenceFlow id="A01bc" sourceRef="AF01b" targetRef="AF01c" />
    <bpmn:sequenceFlow id="A01ret" name="→ bước 4" sourceRef="AF01c" targetRef="Step4" />

    <bpmn:sequenceFlow id="A03t" name="Đổi HĐ" sourceRef="Step2" targetRef="AF03a" />
    <bpmn:sequenceFlow id="A03ab" sourceRef="AF03a" targetRef="AF03b" />
    <bpmn:sequenceFlow id="A03ret" name="→ bước 3" sourceRef="AF03b" targetRef="Step3" />

    <bpmn:sequenceFlow id="A02t" name="Chỉnh ngày" sourceRef="Step5" targetRef="AF02a" />
    <bpmn:sequenceFlow id="A02ab" sourceRef="AF02a" targetRef="AF02b" />
    <bpmn:sequenceFlow id="A02ret" name="→ bước 5" sourceRef="AF02b" targetRef="Step5" />

    <bpmn:sequenceFlow id="ACt" name="Hủy / ✕ (bất kỳ bước 2–6)" sourceRef="Step6" targetRef="AFCa" />
    <bpmn:sequenceFlow id="ACab" sourceRef="AFCa" targetRef="AFCb" />
    <bpmn:sequenceFlow id="ACend" sourceRef="AFCb" targetRef="End2" />

    <bpmn:sequenceFlow id="EFt" name="Không" sourceRef="Gw7" targetRef="EF" />
    <bpmn:sequenceFlow id="EFret" name="→ Quay bước 6" sourceRef="EF" targetRef="Step6" />
  </bpmn:process>

